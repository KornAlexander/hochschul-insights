Landingpage =
"<div class=""landing-root"">
<style>

  :root{
    --ink:#0b1d3a;
    --ink-soft:#3a4a6b;
    --ink-mute:#6b7891;
    --accent:#f5b400;
    --accent-soft:#ffd76a;
    --paper:#ffffff;
    --paper-2:#f5f3ee;
    --line:rgba(11,29,58,.10);
    --line-strong:rgba(11,29,58,.18);
    --navbar-h:88px;
  }
  *{box-sizing:border-box;margin:0;padding:0}
  

  /* Full-bleed stage anchored via fixed positioning — fills the entire
     HTML Content visual regardless of iframe height quirks. */
  .stage{
    position:fixed; inset:0;
    background:
      radial-gradient(1200px 600px at 88% -10%, rgba(245,180,0,.18), transparent 60%),
      radial-gradient(900px 600px at -5% 110%, rgba(11,29,58,.06), transparent 55%),
      linear-gradient(180deg, #ffffff 0%, #faf8f2 100%);
    overflow:hidden;
  }

  /* Reserved empty band at the top for the user's own nav bar overlay */
  .topbar-reserve{
    position:absolute; top:0; left:0; right:0;
    height:var(--navbar-h);
    z-index:5;
    pointer-events:none;
  }

  .backdrop{
    position:absolute; inset:var(--navbar-h) 0 0 0;
    z-index:0; opacity:.45; pointer-events:none;
  }
  .backdrop svg{width:100%;height:100%}

  .glyphs{position:absolute; inset:var(--navbar-h) 0 0 0; z-index:1; pointer-events:none}
  .glyph{position:absolute; color:rgba(11,29,58,.08)}
  .glyph.book   { top:14%;  left:3%;   width:110px; transform:rotate(-8deg) }
  .glyph.cap    { top:70%;  left:4%;   width:120px; transform:rotate(6deg) }
  .glyph.atom   { top:18%;  right:4%;  width:150px; transform:rotate(10deg); color:rgba(11,29,58,.06) }
  .glyph.chart  { bottom:10%; right:6%; width:150px; transform:rotate(-4deg); color:rgba(245,180,0,.28) }
  .glyph.sigma  { top:50%;  left:48%;  width:80px;  transform:translate(-50%,-50%) rotate(-3deg); color:rgba(11,29,58,.05) }

  /* Centered content. A narrow band on the right is reserved for an overlay visual. */
  .content{
    position:absolute;
    top:var(--navbar-h); left:0; bottom:0;
    right:32%;
    z-index:2;
    display:flex; flex-direction:column;
    justify-content:center; align-items:center;
    padding: 40px 72px 80px 72px;
    text-align:center;
  }

  /* Reserved area for the user's own Power BI visual (right side) */
  .visual-reserve{
    position:absolute;
    top:var(--navbar-h); right:0; bottom:0;
    width:32%;
    z-index:2;
    pointer-events:none;
    /* outline:1px dashed rgba(11,29,58,.2); */
  }

  .eyebrow{
    display:inline-flex; align-items:center; gap:10px;
    font-size:12px; letter-spacing:.22em; text-transform:uppercase;
    color:var(--ink-soft); font-weight:600;
    margin-bottom:18px;
  }
  .eyebrow .dot{
    width:8px;height:8px;border-radius:50%;background:var(--accent);
    box-shadow:0 0 14px rgba(245,180,0,.55);
  }

  h1{
    font-size:clamp(40px, 4.8vw, 68px);
    font-weight:700; line-height:1.04; letter-spacing:-.02em;
    margin-bottom:22px; color:var(--ink);
    max-width:760px;
  }
  h1 .accent{
    color:var(--ink);
    background:linear-gradient(180deg, transparent 62%, rgba(245,180,0,.45) 62%, rgba(245,180,0,.45) 92%, transparent 92%);
    background-repeat:no-repeat;
    background-size:0% 100%;
    padding:0 4px;
    animation: hi-draw 900ms cubic-bezier(.2,.7,.2,1) 1100ms forwards;
  }

  .lede{
    font-size:clamp(16px, 1.25vw, 20px);
    line-height:1.55; color:var(--ink-soft);
    max-width:680px; margin: 0 auto 36px; font-weight:400;
  }

  .meta{display:flex; flex-wrap:wrap; gap:14px 28px; margin: 0 auto 40px; justify-content:center}
  .meta .item{display:flex; align-items:center; gap:10px; color:var(--ink-mute); font-size:13px}
  .meta .item svg{width:16px; height:16px; color:var(--accent)}

  .kpis{
    display:grid;
    grid-template-columns:repeat(3, minmax(0,1fr));
    gap:18px; width:100%; max-width:680px; margin: 0 auto;
  }
  .kpi{
    position:relative;
    padding:22px 22px 20px;
    border-radius:14px;
    background:#fff;
    border:1px solid var(--line);
    box-shadow: 0 1px 0 rgba(11,29,58,.04), 0 12px 30px -18px rgba(11,29,58,.18);
    text-align:left;
  }
  .kpi .v{font-size:30px; font-weight:700; letter-spacing:-.02em; color:var(--ink)}
  .kpi .l{font-size:12px; color:var(--ink-mute); margin-top:6px; line-height:1.35}
  .kpi .b{position:absolute; top:14px; right:14px; width:6px; height:6px; border-radius:50%; background:var(--accent)}

  .footer{
    position:absolute;
    left:72px; right:72px; bottom:24px;
    z-index:3;
    display:flex; justify-content:space-between; align-items:center;
    font-size:12px; color:var(--ink-mute);
    letter-spacing:.04em;
  }
  .footer .brand{display:flex; align-items:center; gap:10px}
  .footer .brand b{color:var(--ink); font-weight:700; letter-spacing:.06em}
  .footer .sep{width:1px; height:14px; background:var(--line-strong)}

  /* ---------- Animations ---------- */
  @keyframes hi-rise{
    from{ opacity:0; transform:translateY(14px) }
    to  { opacity:1; transform:translateY(0) }
  }
  @keyframes hi-draw{ to{ background-size:100% 100% } }
  @keyframes hi-pulse{
    0%,100%{ box-shadow:0 0 0 0 rgba(245,180,0,.55) }
    50%    { box-shadow:0 0 0 6px rgba(245,180,0,0) }
  }
  @keyframes hi-drift-a{
    0%,100%{ transform:translate(0,0) rotate(var(--rot,0deg)) }
    50%    { transform:translate(10px,-12px) rotate(calc(var(--rot,0deg) + 2deg)) }
  }
  @keyframes hi-drift-b{
    0%,100%{ transform:translate(0,0) rotate(var(--rot,0deg)) }
    50%    { transform:translate(-12px,10px) rotate(calc(var(--rot,0deg) - 2deg)) }
  }
  @keyframes hi-bg-shift{
    0%,100%{ background-position: 0% 0%, 0% 0%, 0% 0% }
    50%    { background-position: 3% 2%, -3% -2%, 0% 0% }
  }

  /* Ambient: gentle gradient breathing on the stage */
  .stage{
    background-size: 130% 130%, 130% 130%, 100% 100%;
    animation: hi-bg-shift 22s ease-in-out infinite;
  }

  /* Entrance stagger for content blocks */
  .eyebrow,
  .content h1,
  .lede,
  .meta,
  .kpis .kpi,
  .footer{
    opacity:0;
    animation: hi-rise 700ms cubic-bezier(.2,.7,.2,1) forwards;
  }
  .eyebrow      { animation-delay: 120ms }
  .content h1   { animation-delay: 260ms }
  .lede         { animation-delay: 440ms }
  .meta         { animation-delay: 600ms }
  .kpis .kpi:nth-child(1){ animation-delay: 760ms }
  .kpis .kpi:nth-child(2){ animation-delay: 880ms }
  .kpis .kpi:nth-child(3){ animation-delay: 1000ms }
  .footer       { animation-delay: 1200ms }

  /* Pulsing accent dot */
  .eyebrow .dot{ animation: hi-pulse 2.4s ease-in-out infinite }

  /* Ambient floating glyphs (preserve their rotation via --rot) */
  .glyph.book  { --rot:-8deg; animation: hi-drift-a 14s ease-in-out infinite }
  .glyph.cap   { --rot: 6deg; animation: hi-drift-b 17s ease-in-out infinite }
  .glyph.atom  { --rot:10deg; animation: hi-drift-a 19s ease-in-out infinite; animation-delay:-3s }
  .glyph.chart { --rot:-4deg; animation: hi-drift-b 16s ease-in-out infinite; animation-delay:-5s }

  @media (prefers-reduced-motion: reduce){
    .eyebrow, .content h1, .lede, .meta, .kpis .kpi, .footer{
      opacity:1; animation:none;
    }
    .stage, .eyebrow .dot, .glyph{ animation:none }
    h1 .accent{ background-size:100% 100%; animation:none }
  }

</style>

  <div class=""stage"">

    <div class=""topbar-reserve"" aria-hidden=""true""></div>

    <!-- Right side kept clear so an overlay Power BI visual fits in here -->
    <div class=""visual-reserve"" aria-hidden=""true""></div>

    <div class=""backdrop"" aria-hidden=""true"">
      <svg viewBox=""0 0 1600 900"" preserveAspectRatio=""xMidYMid slice"" xmlns=""http://www.w3.org/2000/svg"">
        <defs>
          <pattern id=""grid"" width=""48"" height=""48"" patternUnits=""userSpaceOnUse"">
            <path d=""M48 0H0V48"" fill=""none"" stroke=""#0b1d3a"" stroke-width=""0.5"" stroke-opacity=""0.18""/>
          </pattern>
          <radialGradient id=""fade"" cx=""50%"" cy=""50%"" r=""60%"">
            <stop offset=""0%"" stop-color=""white"" stop-opacity=""1""/>
            <stop offset=""100%"" stop-color=""white"" stop-opacity=""0""/>
          </radialGradient>
          <mask id=""m""><rect width=""100%"" height=""100%"" fill=""url(#fade)""/></mask>
        </defs>
        <rect width=""100%"" height=""100%"" fill=""url(#grid)"" mask=""url(#m)""/>
      </svg>
    </div>

    <div class=""glyphs"" aria-hidden=""true"">
      <svg class=""glyph book"" viewBox=""0 0 64 64"" fill=""none"" stroke=""currentColor"" stroke-width=""1.8"">
        <path d=""M4 12c10-4 18-2 28 4 10-6 18-8 28-4v40c-10-4-18-2-28 4-10-6-18-8-28-4V12z""/>
        <path d=""M32 16v40""/>
      </svg>
      <svg class=""glyph cap"" viewBox=""0 0 64 64"" fill=""none"" stroke=""currentColor"" stroke-width=""1.8"">
        <path d=""M2 24L32 12l30 12-30 12L2 24z""/>
        <path d=""M14 30v12c0 4 8 8 18 8s18-4 18-8V30""/>
        <path d=""M58 26v14""/>
      </svg>
      <svg class=""glyph atom"" viewBox=""0 0 64 64"" fill=""none"" stroke=""currentColor"" stroke-width=""1.6"">
        <circle cx=""32"" cy=""32"" r=""4"" fill=""currentColor""/>
        <ellipse cx=""32"" cy=""32"" rx=""28"" ry=""11""/>
        <ellipse cx=""32"" cy=""32"" rx=""28"" ry=""11"" transform=""rotate(60 32 32)""/>
        <ellipse cx=""32"" cy=""32"" rx=""28"" ry=""11"" transform=""rotate(120 32 32)""/>
      </svg>
      <svg class=""glyph chart"" viewBox=""0 0 64 64"" fill=""none"" stroke=""currentColor"" stroke-width=""2"">
        <path d=""M6 56h52""/>
        <rect x=""12"" y=""34"" width=""8"" height=""20""/>
        <rect x=""26"" y=""22"" width=""8"" height=""32""/>
        <rect x=""40"" y=""10"" width=""8"" height=""44""/>
      </svg>
      <svg class=""glyph sigma"" viewBox=""0 0 64 64"" fill=""none"" stroke=""currentColor"" stroke-width=""2.4"" stroke-linecap=""round"" stroke-linejoin=""round"">
        <path d=""M14 10h36L26 32l24 22H12""/>
      </svg>
    </div>

    <div class=""content"">
      <div class=""eyebrow""><span class=""dot""></span> Hochschul-Insights</div>
      <h1>Daten, die Hochschulen <span class=""accent"">bewegen.</span></h1>
      <p class=""lede"">
        Studierende, Studienanfänger und Absolventen — bundesweit, vergleichbar,
        aktuell. Auf Basis offizieller GENESIS-Statistiken, aufbereitet in
        Microsoft Fabric und visualisiert nach IBCS-Standards.
      </p>

      <div class=""meta"">
        <div class=""item"">
          <svg viewBox=""0 0 24 24"" fill=""none"" stroke=""currentColor"" stroke-width=""2""><path d=""M3 7h18M3 12h18M3 17h12""/></svg>
          Quelle: Statistisches Bundesamt (GENESIS-Online)
        </div>
        <div class=""item"">
          <svg viewBox=""0 0 24 24"" fill=""none"" stroke=""currentColor"" stroke-width=""2""><circle cx=""12"" cy=""12"" r=""9""/><path d=""M12 7v5l3 2""/></svg>
          Zeitraum 2019 – 2024
        </div>
        <div class=""item"">
          <svg viewBox=""0 0 24 24"" fill=""none"" stroke=""currentColor"" stroke-width=""2""><path d=""M4 4h16v6H4zM4 14h16v6H4z""/></svg>
          Microsoft Fabric · Direct Lake
        </div>
      </div>

      <div class=""kpis"">
        <div class=""kpi"">
          <span class=""b""></span>
          <div class=""v"">16</div>
          <div class=""l"">GENESIS-Tabellen<br/>integriert</div>
        </div>
        <div class=""kpi"">
          <span class=""b""></span>
          <div class=""v"">6</div>
          <div class=""l"">Berichtsjahre<br/>2019 – 2024</div>
        </div>
        <div class=""kpi"">
          <span class=""b""></span>
          <div class=""v"">16</div>
          <div class=""l"">Bundesländer<br/>vollständig</div>
        </div>
      </div>
    </div>

    <div class=""footer"">
      <div class=""brand"">
        <span>Daten: Statistisches Bundesamt</span>
        <span class=""sep""></span>
        <span>Visualisierung nach IBCS&reg;</span>
        <span class=""sep""></span>
        <span>Powered by Microsoft Fabric</span>
      </div>
      <div class=""brand"">
        <b>HOCHSCHUL&nbsp;INSIGHTS</b>
      </div>
    </div>

  </div>

</div>"
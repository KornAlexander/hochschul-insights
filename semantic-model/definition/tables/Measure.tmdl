table Measure
	lineageTag: c27b64b6-4468-4cc2-bf63-f00b9fb0f16d

	/// This measure is the sum of column 'drittmittel'[Wert_EUR]
	measure 'Drittmittel EUR Detail' = SUM('Drittmittel'[Wert_EUR])
		formatString: #,##0.0
		displayFolder: Drittmittel
		lineageTag: d7a9580e-a25c-458e-bffb-d113eb7f4595

	/// This measure is the sum of column 'Studierende'[Wert]
	measure Studierende =
			SUM('Studierende'[Wert])
			/*
			IF (
			    ISFILTERED ( 'Calendar'[Jahr] ),
			    SUM('Studierende'[Wert]),
			    CALCULATE ( SUM('Studierende'[Wert]), 'Calendar'[Jahr] = 2024 )
			)*/
		formatString: #,##0
		displayFolder: Studierende
		lineageTag: 5a654499-babf-424e-a6a9-d07f43b14e58

	/// This measure is the sum of column 'Hochschulfinanzen'[Wert_EUR]
	measure 'Wert EUR' = SUM('Hochschulfinanzen'[Wert_EUR])
		formatString: #,##0.0
		displayFolder: Hochschulfinanzen
		lineageTag: 1b946432-6f95-442f-bea2-04bb89eb8fce

	/// This measure is the sum of column 'Einnahmen'[Wert_EUR]
	measure 'Einnahmen EUR Detail' = SUM('Einnahmen'[Wert_EUR])
		formatString: #,##0.0
		displayFolder: Einnahmen
		lineageTag: 860a4bab-dcab-4a26-be34-2eda770e6b3b

	/// This measure is the sum of column 'Ausgaben'[Wert_EUR]
	measure 'Ausgaben EUR Detail' = SUM('Ausgaben'[Wert_EUR])
		formatString: #,##0.0
		displayFolder: Ausgaben
		lineageTag: a37db327-5439-4191-b5a5-58addfd4d7b0

	/// This measure is the sum of column 'Professoren'[Wert]
	measure Professoren = SUM('Professoren'[Wert])
		formatString: #,##0
		displayFolder: Professoren
		lineageTag: 2b844c95-af04-4af4-83f7-5444910e34bb

	/// This measure is the sum of column 'Studienanfaengerhochschule'[Wert]
	measure Studienanfänger = SUM('Studienanfänger'[Wert])
		formatString: #,##0
		displayFolder: Studienanfänger
		lineageTag: 562595a7-f5a1-46e6-8428-d8d1614521e5

	/// Share of female students. Denominator excludes the GENESIS "Insgesamt" subtotal.
	measure '% of Studierende weiblich' =
			DIVIDE(
				CALCULATE([Studierende], 'Geschlecht'[Geschlecht] = "weiblich"),
				CALCULATE([Studierende], 'Geschlecht'[Geschlecht] IN { "männlich", "weiblich" })
			)
		formatString: 0.0 %
		displayFolder: Studierende
		lineageTag: a1b2c3d4-0001-4000-8000-000000000001

	/// Share of male students. Denominator excludes the GENESIS "Insgesamt" subtotal.
	measure '% of Studierende männlich' =
			DIVIDE(
				CALCULATE([Studierende], 'Geschlecht'[Geschlecht] = "männlich"),
				CALCULATE([Studierende], 'Geschlecht'[Geschlecht] IN { "männlich", "weiblich" })
			)
		formatString: 0.0 %
		displayFolder: Studierende
		lineageTag: a1b2c3d4-0002-4000-8000-000000000002

	/// Share of international ("Ausländer") students. Denominator excludes the GENESIS "Insgesamt" subtotal.
	measure '% of Studierende International' =
			DIVIDE(
				CALCULATE([Studierende], 'Nationalität'[Nationalitaet] = "Ausländer"),
				CALCULATE([Studierende], 'Nationalität'[Nationalitaet] IN { "Deutsche", "Ausländer" })
			)
		formatString: 0.0 %
		displayFolder: Studierende
		lineageTag: a1b2c3d4-0003-4000-8000-000000000003

	/// Share of German students. Denominator excludes the GENESIS "Insgesamt" subtotal.
	measure '% of Studierende Deutsch' =
			DIVIDE(
				CALCULATE([Studierende], 'Nationalität'[Nationalitaet] = "Deutsche"),
				CALCULATE([Studierende], 'Nationalität'[Nationalitaet] IN { "Deutsche", "Ausländer" })
			)
		formatString: 0.0 %
		displayFolder: Studierende
		lineageTag: a1b2c3d4-0004-4000-8000-000000000004

	measure 'Studierende PY' =
			CALCULATE(
			    [Studierende],
			    SAMEPERIODLASTYEAR( Calendar[Datum] )
			)
